# Environment template — copy to `.env` at the REPOSITORY ROOT and adjust as needed.
# That single file configures the backend for both workflows (Docker Compose and
# `cd backend && uvicorn app.main:app`); `backend/.env` is also read and overrides it.
# Real environment variables take precedence over values in this file.
# Do NOT put real credentials in this file. `.env` is git-ignored.

# --- Backend ---
APP_ENV=development

# Maximum accepted text length (default 1000, configurable per api-contract.md).
MAX_TEXT_LENGTH=1000

# Allowed browser origins (JSON array). Development origins only.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- LLM provider (Google Gemini Developer API) ---
# Secret. Read only by the backend and never exposed to the frontend, responses,
# or logs. Leave empty in this template and never commit a real key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ID. Default: gemini-3.8-flash (stable, free-tier Flash text model).
# Override to switch models without a code change.
GEMINI_MODEL=gemini-3.8-flash

# Gemini Developer API base URL and per-request timeout in seconds.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=30
